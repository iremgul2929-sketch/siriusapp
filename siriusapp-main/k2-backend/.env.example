# Bu dosyayı .env olarak kopyalayın ve gerekiyorsa değiştirin.

# Model dosyaları (yoksa backend DEMO modunda çalışır)
SIRIUS_MODEL_PATH=models/sirius.tflite
SIRIUS_LABELS_PATH=models/labels.json
# MediaPipe el modeli; yoksa "el var/yok" bilgisi gönderilmez
SIRIUS_LANDMARKER_PATH=../k1-yapay-zeka/models/hand_landmarker.task

# Tahmin ayarları
SIRIUS_CONFIDENCE_THRESHOLD=0.80
SIRIUS_VOTE_FRAMES=3
# Demo modunda kaç karede bir rastgele kelime gönderilsin (4 kare/sn'de 12 ≈ 3 sn)
SIRIUS_MOCK_EVERY=12
