# Bu dosyayı .env olarak kopyalayın.
# Backend'in adresi. Ortama göre birini seçin:
#
#  Gerçek telefon (aynı Wi-Fi): bilgisayarınızın yerel IP'si
#      macOS'ta öğrenmek için: ipconfig getifaddr en0
#  Genymotion emülatörü:        http://10.0.3.2:8000
#  Web (tarayıcı, w tuşu):      http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
